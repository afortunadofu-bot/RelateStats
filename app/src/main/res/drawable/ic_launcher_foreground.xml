<?xml version="1.0" encoding="utf-8"?>
<!--
  三個大小遞增、彼此交疊的圓 ＝ 人，以及你跟他們重疊多少。
  圓越大表示佔掉你越多注意力；最大的那個用品牌藍點出重點。

  ⚠️ 所有圖形都必須落在 108 畫布的中央 72x72 安全區（18..90）內，
     否則不同廠商的圓形／方形遮罩會把邊緣切掉。
  ⚠️ 只用實心形狀，不用細線與細環：縮到 16px 時 1px 以下的線會整條消失，
     連接關係只能靠「交疊」來表達。
  繪製順序：小 → 大。最大的藍圓最後畫，蓋住部分白圓，
  交疊處自然形成層次，不需要額外的描邊或陰影。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:fillColor="#F8FAFC"
        android:fillAlpha="0.55"
        android:pathData="M30,54m-9,0a9,9 0,1 0,18 0a9,9 0,1 0,-18 0z" />
    <path
        android:fillColor="#F8FAFC"
        android:fillAlpha="0.85"
        android:pathData="M48,54m-13,0a13,13 0,1 0,26 0a13,13 0,1 0,-26 0z" />
    <path
        android:fillColor="#3B82F6"
        android:pathData="M70,54m-18,0a18,18 0,1 0,36 0a18,18 0,1 0,-36 0z" />
</vector>
