<?xml version="1.0" encoding="utf-8"?>
<!--
  三根遞增的膠囊 ＝ 統計；最高那根頂端的圓點 ＝ 你花最多注意力的那個人。

  ⚠️ 所有圖形都必須落在 108 畫布的中央 72x72 安全區（18..90）內，
     否則不同廠商的圓形／方形遮罩會把邊緣切掉。
  ⚠️ 只用兩個顏色、沒有漸層與陰影：縮到 24px 時任何裝飾都會糊成雜訊。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- 膠囊寬 13、基線 y=78；三根 x 中心 34.5 / 53.5 / 72.5 -->
    <path
        android:fillColor="#F8FAFC"
        android:fillAlpha="0.55"
        android:pathData="M34.5,64m-6.5,0a6.5,6.5 0,1 1,13 0l0,7.5a6.5,6.5 0,1 1,-13 0z" />
    <path
        android:fillColor="#F8FAFC"
        android:fillAlpha="0.8"
        android:pathData="M53.5,54m-6.5,0a6.5,6.5 0,1 1,13 0l0,17.5a6.5,6.5 0,1 1,-13 0z" />
    <path
        android:fillColor="#F8FAFC"
        android:pathData="M72.5,44m-6.5,0a6.5,6.5 0,1 1,13 0l0,27.5a6.5,6.5 0,1 1,-13 0z" />
    <!-- 節點：比膠囊寬，蓋在最高那根頂端，像一根被標記的指標 -->
    <path
        android:fillColor="#3B82F6"
        android:pathData="M72.5,30m-9,0a9,9 0,1 0,18 0a9,9 0,1 0,-18 0z" />
</vector>
