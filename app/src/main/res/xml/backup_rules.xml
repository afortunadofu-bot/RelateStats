<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 11 以下的自動備份規則。全部排除。

  ⚠️ allowBackup="false" 其實就已經關掉這一版的自動備份了，
     這個檔留著是第二道鎖：萬一哪天有人把 allowBackup 改回 true，
     也不會立刻又把聯絡人名字送上雲端。詳細理由見 data_extraction_rules.xml。
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
