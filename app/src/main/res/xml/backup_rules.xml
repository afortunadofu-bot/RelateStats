<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 11 以下的自動備份規則。只含主要資料檔。

  ⚠️ 不要再加 exclude：已經只 include 一個檔，exclude 別的檔會被 release lint
     判成致命錯誤。
  ⚠️ 自動備份是刻意留著的，代價與關掉的方法見 data_extraction_rules.xml。
-->
<full-backup-content>
    <include domain="sharedpref" path="RelateStatsData.xml" />
</full-backup-content>
